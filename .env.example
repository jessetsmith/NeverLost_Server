# Non-secret configuration (safe to commit as .env.example)
SANITY_PROJECT_ID=492nxyas
SANITY_DATASET=production

# Secrets belong in .env.local (never commit):
# SANITY_TOKEN=
# JWT_SECRET=
# SKETCHFAB_API_TOKEN=
# SKETCHFAB_CLIENT_ID=
# SKETCHFAB_CLIENT_SECRET=

# ── Environment profiles ─────────────────────────────────────────────
# Profile files live in env/ (committed, no secrets):
#   env/local.env      → localhost Sketchfab OAuth redirect
#   env/production.env → GitHub Pages Sketchfab OAuth redirect
#
# Local server (pick one):
#   npm start              → local profile (default)
#   npm run start:production → production profile (test prod OAuth locally)
#
# Deployed API uses Firebase defineString defaults in index.js (production URLs).
# Set SKETCHFAB_CLIENT_SECRET in Firebase Console → Functions → Environment variables.
